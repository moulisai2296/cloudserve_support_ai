# CloudServe Intelligent Customer Support - Environment Configuration
# Copy this file to .env and fill in your real API keys.
# .env is gitignored and will never be committed to source control.

# ==============================================================================
# Model Provider Configuration
# OpenRouter is the implemented provider. Leave the key empty for offline work.
# ==============================================================================
OPENROUTER_API_KEY=

# Default generation and classification model
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==============================================================================
# Storage Paths
# ==============================================================================
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

# ==============================================================================
# Routing & Policy Thresholds
# ==============================================================================
# Routing confidence floor; calibration must be measured, not assumed.
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=3
RETRIEVAL_SIMILARITY_THRESHOLD=0.40
# Guardrail response confidence floor (minimum confidence required to pass pre-release safety checks)
GUARDRAIL_CONFIDENCE_THRESHOLD=0.70

# ==============================================================================
# Operational & Governance Controls
# ==============================================================================
LOG_LEVEL=INFO
# Administrative Kill-Switch: set to true to force 100% human escalation immediately
KILL_SWITCH_ACTIVE=false

# HuggingFace & Tokenizer Verbosity
HF_HUB_VERBOSITY=error
HF_HUB_DISABLE_PROGRESS_BARS=1
TOKENIZERS_PARALLELISM=false
